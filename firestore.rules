rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para la colección de grupos
    match /groups/{groupId} {
      // Permitir lectura si el usuario es miembro del grupo
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      
      // Permitir creación a cualquier usuario autenticado
      allow create: if request.auth != null;
      
      // Permitir actualización si el usuario es miembro
      allow update: if request.auth != null && request.auth.uid in resource.data.members;

      // Reglas para la subcolección de gastos
      match /expenses/{expenseId} {
        // Solo miembros del grupo padre pueden ver o registrar gastos
        allow read, write: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }
    }
  }
}
